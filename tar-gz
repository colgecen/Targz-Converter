#!/usr/bin/env bash
#
# tar-gz — Targz Converter derleme/paketleme araci
#
# Kullanim:
#   ./tar-gz                      -> interaktif menü (format sec -> paketle)
#   ./tar-gz --list               -> paket seceneklerini listele
#   ./tar-gz linux targz           -> direkt paketle (argümanli, menüsüz)
#   ./tar-gz linux zip
#   ./tar-gz --install            -> ~/.local/bin'e sembolik bag kur,
#                                    sonra her klasörden `tar-gz` yazman yeterli
#   ./tar-gz --help               -> yardim
#
set -euo pipefail

VERSION="${VERSION:-1.0.0}"
ARCH="${ARCH:-x86_64}"
resolve_root() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}
ROOT="$(resolve_root)"

banner() {
  echo "=============================================="
  echo "  Targz Converter — tar-gz paketleme araci  v$VERSION"
  echo "=============================================="
}

usage() {
  banner
  echo
  echo "Kullanim:"
  echo "  ./tar-gz                     Interaktif menü"
  echo "  ./tar-gz <os> <format>        Direkt paketle"
  echo "  ./tar-gz --list              Secenekleri listele"
  echo "  ./tar-gz --install           Komutu sisteme kur (her yerden 'tar-gz')"
  echo "  ./tar-gz --help              Bu yardim"
  echo
  echo "Hedefler:"
  echo "  linux   : appimage | targz | zip | rpm"
  echo
  echo "Ornekler:"
  echo "  ./tar-gz linux targz"
  echo "  ./tar-gz linux zip"
  echo "  ./tar-gz linux rpm"
  echo "  ARCH=aarch64 ./tar-gz linux appimage"
  echo "  VERSION=1.1.0 ./tar-gz linux targz"
}

list_targets() {
  echo "linux   : appimage (.AppImage) | targz (.tar.gz) | zip (.zip) | rpm (.rpm)"
}

do_install() {
  local bindir="$HOME/.local/bin"
  mkdir -p "$bindir"
  ln -sf "$ROOT/tar-gz" "$bindir/tar-gz"
  echo "Kuruldu: $bindir/tar-gz -> $ROOT/tar-gz"
  case ":$PATH:" in
    *":$bindir:"*) echo "PATH zaten '$bindir' iceriyor. Artik her klasorden 'tar-gz' yazabilirsin." ;;
    *)
      echo "NOT: '$bindir' PATH'te yok. Su satiri ~/.bashrc'ye ekle:"
      echo "  export PATH=\"\$HOME/.local/bin:\$PATH\""
      ;;
  esac
}

package_appimage() {
  mkdir -p "$ROOT/build"
  local appdir="$ROOT/build/TargzConverter.AppDir"
  rm -rf "$appdir"
  mkdir -p "$appdir/usr/bin" "$appdir/usr/share/applications" "$appdir/usr/share/icons/hicolor/256x256/apps"

  # kaynak kodu göm
  cp -r "$ROOT/targz_converter" "$appdir/usr/bin/"
  cp "$ROOT/targz2app.py" "$ROOT/install.py" "$appdir/usr/bin/"
  cp "$ROOT/assets/targz-converter.png" "$appdir/usr/share/icons/hicolor/256x256/apps/targz-converter.png"
  cp "$ROOT/assets/targz-converter.png" "$appdir/targz-converter.png"

  cat > "$appdir/targz-converter.desktop" << 'DESKTOP'
[Desktop Entry]
Name=Targz Converter
Exec=targz-converter
Icon=targz-converter
Type=Application
Categories=Utility;Archiving;FileTools;
Terminal=false
DESKTOP
  cp "$appdir/targz-converter.desktop" "$appdir/usr/share/applications/"

  cat > "$appdir/AppRun" << 'APPRUN'
#!/bin/bash
HERE="$(dirname "$(readlink -f "$0")")"
export PYTHONPATH="$HERE/usr/bin:$PYTHONPATH"
exec python3 "$HERE/usr/bin/targz2app.py" "$@"
APPRUN
  chmod +x "$appdir/AppRun"

  local out="$ROOT/build/Targz-Converter-$ARCH.AppImage"
  echo "==> AppImage paketleniyor: $out"
  set +e
  ARCH="$ARCH" ${APPIMAGETOOL_CMD:-appimagetool} "$appdir" "$out" > /tmp/appimage.log 2>&1
  rc1=$?
  cat /tmp/appimage.log
  if [ $rc1 -ne 0 ] && [ ! -f "$out" ]; then
    echo "AppImage üretilemedi rc=$rc1"
    exit 1
  fi
  set -e
  chmod +x "$out"
  rm -rf "$appdir"
  echo "==> $out"
}

package_targz() {
  mkdir -p "$ROOT/build"
  local out="$ROOT/build/targz-converter-$VERSION-$ARCH.tar.gz"
  echo "==> tar.gz paketleniyor: $out"
  tar --exclude='./.git' --exclude='./build' --exclude='./__pycache__' \
      --exclude='*.pyc' -czf "$out" -C "$ROOT" .
  echo "==> $out"
}

package_zip() {
  mkdir -p "$ROOT/build"
  local out="$ROOT/build/targz-converter-$VERSION-$ARCH.zip"
  echo "==> zip paketleniyor: $out"
  (cd "$ROOT" && zip -r "$out" . -x '.git/*' 'build/*' '__pycache__/*' '*.pyc' >/dev/null)
  echo "==> $out"
}

package_rpm() {
  if ! command -v rpmbuild >/dev/null 2>&1; then
    echo "rpmbuild bulunamadi. Kur: sudo dnf install rpm-build / sudo apt install rpm" >&2
    exit 1
  fi
  mkdir -p "$ROOT/build"
  local name="targz-converter"
  local ver="$VERSION"
  local rpmarch
  case "$ARCH" in
    arm64|aarch64) rpmarch="aarch64" ;;
    amd64|x86_64|x64) rpmarch="x86_64" ;;
    *) rpmarch="$ARCH" ;;
  esac
  local top="$ROOT/build/rpmbuild"
  rm -rf "$top"
  mkdir -p "$top"/{BUILD,RPMS,SOURCES,SPECS,SRPMS}
  local src="$name-$ver"
  local stage="$top/$src"
  mkdir -p "$stage"
  cp -r "$ROOT/targz_converter" "$stage/"
  cp "$ROOT/targz2app.py" "$ROOT/install.py" "$ROOT/LICENSE" "$stage/" 2>/dev/null || true
  [ -d "$ROOT/assets" ] && cp -r "$ROOT/assets" "$stage/"
  find "$stage" -name '__pycache__' -type d -prune -exec rm -rf {} + 2>/dev/null || true
  find "$stage" -name '*.pyc' -delete 2>/dev/null || true
  tar -czf "$top/SOURCES/$src.tar.gz" -C "$top" "$src"

  cat > "$top/SPECS/$name.spec" <<SPEC
%define debug_package %{nil}
Name:           $name
Version:        $ver
Release:        1
Summary:        Convert archives into runnable apps in Linux
License:        MIT
URL:            https://github.com/colgecen/Targz-Converter
Source0:        %{name}-%{version}.tar.gz
BuildArch:      $rpmarch
Requires:       python3
Requires:       tar
Requires:       unzip

%description
Targz Converter turns tar.gz, tgz, tar.xz, tar.bz2, AppImage, rpm, deb,
zip and 7z archives into runnable Linux applications with a desktop
shortcut and icon. This package installs the tool under /opt.

%prep
%setup -q

%build
# Python sources; nothing to compile.

%install
mkdir -p %{buildroot}/opt/$name
cp -r targz_converter targz2app.py install.py assets %{buildroot}/opt/$name/ 2>/dev/null || true
mkdir -p %{buildroot}/usr/bin
cat > %{buildroot}/usr/bin/targz-converter <<'LAUNCHER'
#!/bin/sh
exec python3 /opt/targz-converter/targz2app.py "\$@"
LAUNCHER
chmod 0755 %{buildroot}/usr/bin/targz-converter

%files
/opt/$name
/usr/bin/targz-converter

%changelog
* $(LC_ALL=C date +"%a %b %d %Y") Targz Converter <noreply@github.com> - $ver-1
- Release $ver
SPEC

  local out
  echo "==> rpm paketleniyor ($rpmarch)"
  rpmbuild --define "_topdir $top" --target "$rpmarch" -bb "$top/SPECS/$name.spec" > /tmp/rpm.log 2>&1 || {
    echo "rpmbuild basarisiz, log:" >&2
    tail -40 /tmp/rpm.log >&2
    exit 1
  }
  out="$(find "$top/RPMS" -name '*.rpm' | head -1)"
  if [ -z "$out" ]; then
    echo "rpm uretilemedi" >&2
    exit 1
  fi
  cp "$out" "$ROOT/build/"
  echo "==> $ROOT/build/$(basename "$out")"
}

build_target() {
  local os="$1" fmt="$2"
  banner
  echo "Hedef: OS=$os  Format=$fmt  Version=$VERSION"
  echo
  case "$os" in
    linux)
      case "$fmt" in
        appimage) package_appimage ;;
        targz|tar.gz) package_targz ;;
        zip) package_zip ;;
        rpm) package_rpm ;;
        *)
          echo "Bilinmeyen linux formati: $fmt (gecerli: appimage | targz | zip | rpm)"
          exit 1
          ;;
      esac
      ;;
    *)
      echo "Bilinmeyen OS: $os (gecerli: linux)"
      exit 1
      ;;
  esac
  echo
  echo "Bitti."
}

interactive() {
  banner
  echo
  echo "Paket formati sec:"
  select f in "AppImage (.AppImage)" "tar.gz (.tar.gz)" "zip (.zip)" "rpm (.rpm)" "Vazgec"; do
    case "$REPLY" in
      1) FMT="appimage"; break ;;
      2) FMT="targz"; break ;;
      3) FMT="zip"; break ;;
      4) FMT="rpm"; break ;;
      5|"") echo "Vazgecildi."; exit 0 ;;
      *) echo "Gecersiz secim, tekrar dene." ;;
    esac
  done
  build_target "linux" "$FMT"
}

if [ $# -eq 0 ]; then
  interactive
  exit 0
fi

case "${1:-}" in
  -h|--help|help)
    usage
    ;;
  -l|--list|list)
    list_targets
    ;;
  --install|install)
    do_install
    ;;
  --version|-v)
    echo "tar-gz $VERSION"
    ;;
  linux)
    if [ $# -lt 2 ]; then
      echo "Format eksik. Ornek: ./tar-gz linux targz"
      list_targets
      exit 1
    fi
    OS="$1"; FMT="$2"
    if [ $# -ge 3 ]; then
      VERSION="$3"
    fi
    build_target "$OS" "$FMT"
    ;;
  *)
    echo "Bilinmeyen komut: $1"
    echo
    usage
    exit 1
    ;;
esac
